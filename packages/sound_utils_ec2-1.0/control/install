#!/bin/bash

# Use yum or apt-get to install flac and lame
yum --help >& /dev/null
if [ $? -eq 0 ]; then
  # First add the DAG YUM repository
  wget http://dag.wieers.com/rpm/packages/rpmforge-release/rpmforge-release-0.3.6-1.el5.rf.i386.rpm
  rpm -ivh rpmforge-release-0.3.6-1.el5.rf.i386.rpm
  yum -y install lame flac
else
  sudo apt-get -y install lame flac
fi

chmod +x %BASEDIR%/bin/flac2mp3