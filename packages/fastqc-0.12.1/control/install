#!/bin/bash
# FastQC 0.12.1 (Babraham Bioinformatics, GPL v3): fetched from its release
# page at install time and checked against a pinned SHA-256, so the package
# itself holds no binaries. Runs once per worker, in the package directory.
set -e
cd "%BASEDIR%"
URL=https://www.bioinformatics.babraham.ac.uk/projects/fastqc/fastqc_v0.12.1.zip
SHA256=5f4dba8780231a25a6b8e11ab2c238601920c9704caa5458d9de559575d58aa7
curl -sSfL --max-time 600 -o fastqc.zip "$URL"
echo "$SHA256  fastqc.zip" | sha256sum -c --quiet
python3 -m zipfile -e fastqc.zip .
rm -f fastqc.zip
chmod 755 FastQC/fastqc
chmod -R a+rX FastQC
