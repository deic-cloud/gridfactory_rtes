#!/bin/sh

case "$1" in
	0)
		#none
	;;

	1)
		PATH=%BASEDIR%:$PATH
		# Check for manually installed CUDA-enabled ffmpeg
		if [ -e ~/ffmpeg ]; then
			PATH=~/ffmpeg:$PATH
			export PATH
			LD_LIBRARY_PATH=%BASEDIR%/lib:~/ffmpeg/libavcodec:~/ffmpeg/libavdevice:~/ffmpeg/libavfilter:~/ffmpeg/libavformat:~/ffmpeg/libavutil:~/ffmpeg/libswresample:~/ffmpeg/libswscale:$LD_LIBRARY_PATH
			export LD_LIBRARY_PATH
		fi
	;;

	2)
		#none
	;;

	*)
		return 1
	;;
esac	

# eof
